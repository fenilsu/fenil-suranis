<style>
    .hero-banner-top img{width:100%}
    .hero-banner-bottom{display:flex;}
    .hero-banner-bottom .hero-content{padding: 0 0 0px calc((100% - 1340px) / 2);width: 765px;flex-shrink: 0;}
    .hero-content h1{font-family: "Jost", sans-serif;color:#000000;font-size:70px;font-weight:500;line-height:1;letter-spacing: 0;margin-bottom:50px;}
    .hero-content-image{flex-grow:1;line-height: 0;}
    .hero-content-image img{width:100%;height: 100%;}
    .hero-content p{font-size:20px;line-height:1.4;color:#000000;font-weight:400;font-family: "Jost", sans-serif;letter-spacing: 0;}
    .main-btn{font-size:16px;line-height:20px;font-weight:400;color:#fff;font-family: "Jost", sans-serif;text-transform: uppercase;padding:14px 23px 14px 55px;background-color:#000000;text-decoration: none;margin-top:50px;display:flex;align-items:center;position:relative;transition: 0.3s all ease-in-out;width: fit-content;overflow: hidden;margin-bottom:50px;}
    .main-btn span{transition:0.3s all ease-in-out;}
    .main-btn:hover span{position:relative;color:#000000;}
    .main-btn::before{content:'';width:100%;height:100%;background-color:#FFF544;position: absolute;left: -100%;transition:0.3s all ease-in-out;}
    .main-btn:hover::before{left:0;}
    .main-btn .btn-icon{margin-left:29px;transition:0.3s all ease-in-out;}
    .main-btn:hover .btn-icon svg path{fill:#000000;}
    .hero-bottom-content{padding:10px;background-color:#F5F5F5;}
    .hero-bottom-content p{margin:0;color:#000000;font-size:16px;line-height:14px;font-family: "Jost", sans-serif;font-weight:400;text-align:center;letter-spacing: 0;}

    @media (min-width:1921px){
        .hero-banner-bottom .hero-content{padding:0 0 0 60px;}
    }
    @media (max-width:1680px){
        .hero-banner-bottom .hero-content{width: 642px;}
    }
    @media (max-width:1439px){
        .hero-banner-bottom .hero-content{padding:0 0 0 15px;}
        .hero-banner-bottom .hero-content{width: 486px;}
    }

    @media (max-width:1199px){
        .hero-content h1{font-size:40px;margin-bottom:24px;}
        .hero-content .main-btn{margin-top:24px;}
    }
    @media (max-width:991px){
        .hero-content-image{display:none;}
        .hero-banner-bottom .hero-content{width:100%;text-align: center;padding:0 15px;}
        .hero-content .main-btn{margin:0 auto 50px;}
    }
    @media (max-width:767px){
        .hero-banner-top{display:none;}
        .hero-content-image{display:flex;align-items: flex-end;}
        .hero-banner-bottom .hero-content{position:absolute;top: 32px;height: -webkit-fill-available;display: flex;
        flex-direction: column;}
        .hero-banner-bottom{flex-direction: column-reverse;padding-top: 90px;min-height: 421px;}
        .hero-content h1{font-size:30px;}
        .hero-content p{font-size: 16px;line-height: 1.3;margin-top:0;}
        .hero-content .main-btn{margin-top:auto;}
        .hero-bottom-content p{font-size:14px;line-height:18px;}
        .hero-content .main-btn{padding: 13px 20px 13px 20px;}
        .hero-content .main-btn .btn-icon{margin-left:18px;}
    }
</style>

<div class="hero-banner-main">
    <div class="hero-banner-top">
        <img src="{{ section.settings.top_image | image_url }}" alt="hero-image">
    </div>
    <div class="hero-banner-bottom">
        <div class="hero-content">
            <h1>{{section.settings.hero_title}}</h1>
            <div>{{ section.settings.hero_content }}</div>
            <a class="main-btn" href="{{ section.settings.button_url }}"><span class="btn-text">{{section.settings.button_text}}</span> 
                <span class="btn-icon">
                    <svg width="27" height="12" viewBox="0 0 27 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.75 4.77295L7.83954e-08 4.77295L-7.83954e-08 6.27295L0.75 6.27295L0.75 4.77295ZM26.7876 6.05328C27.0805 5.76039 27.0805 5.28551 26.7876 4.99262L22.0146 0.21965C21.7217 -0.0732435 21.2468 -0.0732435 20.9539 0.21965C20.6611 0.512543 20.6611 0.987417 20.9539 1.28031L25.1966 5.52295L20.9539 9.76559C20.6611 10.0585 20.6611 10.5334 20.9539 10.8263C21.2468 11.1191 21.7217 11.1191 22.0146 10.8263L26.7876 6.05328ZM0.75 6.27295L26.2572 6.27295L26.2572 4.77295L0.75 4.77295L0.75 6.27295Z" fill="white"/>
                    </svg>
                </span>
            </a>
        </div>
        <div class="hero-content-image">
            <img src="{{ section.settings.right_image | image_url }}" alt="">
        </div>
    </div>
    <div class="hero-bottom-content">
        {{ section.settings.hero_bottom_content }}
    </div>
</div>

{% schema %}
{
    "name": "Hero Banner",
    "settings": [
        {
            "type": "image_picker",
            "id": "top_image",
            "label": "Top Image"
        },
        {
            "type": "text",
            "id": "hero_title",
            "label": "Hero Title"
        },
        {
            "type": "richtext",
            "id": "hero_content",
            "label": "Hero Content"
        },
        {
            "type": "text",
            "id": "button_text",
            "label": "Button Text"
        },
        {
            "type": "url",
            "id": "button_url",
            "label": "Button Link"
        },
        {
            "type": "image_picker",
            "id": "right_image",
            "label": "Content Image"
        },
        {
            "type": "richtext",
            "id": "hero_bottom_content",
            "label": "Hero bottom Content"
        }
    ],
    "presets": [
        {
            "name": "Hero Banner"
        }
    ]
}
{% endschema %}